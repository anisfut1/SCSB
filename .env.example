# Copier ce fichier en .env.local (jamais commité) et renseigner les vraies
# valeurs du projet Supabase. Voir README.md pour la procédure complète.

# --- Publiques (exposées au navigateur, préfixe NEXT_PUBLIC_ obligatoire) ---
# URL du projet Supabase (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clé anonyme du projet (Project Settings > API). Soumise à la RLS, sans danger
# à exposer côté client.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Serveur uniquement (ne jamais préfixer par NEXT_PUBLIC_) ---
# Clé service role (Project Settings > API). Bypass TOUTE la RLS.
# Ne doit JAMAIS être utilisée ailleurs que dans du code serveur
# (voir src/lib/supabase/admin.ts, réservé aux tâches système : sync, jobs).
SUPABASE_SERVICE_ROLE_KEY=

# Secret partagé pour protéger les routes /api/internal/* (cron FFBB/FBI).
# Générer une valeur aléatoire, ex: `openssl rand -hex 32`.
CRON_SECRET=

# Clé de chiffrement AES-256 des identifiants FBI (voir src/lib/security/crypto.ts).
# 32 octets encodés en base64. Générer avec : `openssl rand -base64 32`.
# Une rotation de cette clé rend illisibles les identifiants déjà stockés :
# il faudra les ressaisir depuis /admin/integrations/fbi.
FBI_CREDENTIALS_ENCRYPTION_KEY=

# La fréquence des synchronisations (FFBB, découverte e-Marque) est
# configurée dans vercel.json (cron), pas ici — voir ce fichier.

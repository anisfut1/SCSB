# Copier ce fichier en .env.local (jamais commité) et renseigner les vraies
# valeurs du projet Supabase. Voir README.md pour la procédure complète.

# --- Publiques (exposées au navigateur, préfixe NEXT_PUBLIC_ obligatoire) ---
# URL du projet Supabase (Project Settings > API).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clé anonyme du projet (Project Settings > API). Soumise à la RLS, sans danger
# à exposer côté client.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Serveur uniquement (ne jamais préfixer par NEXT_PUBLIC_) ---
# Clé service role (Project Settings > API). Bypass TOUTE la RLS.
# Ne doit JAMAIS être utilisée ailleurs que dans du code serveur
# (voir src/lib/supabase/admin.ts, réservé aux futures tâches système).
SUPABASE_SERVICE_ROLE_KEY=

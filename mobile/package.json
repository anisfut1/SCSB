{
  "name": "ball-manager-ios",
  "version": "1.0.0",
  "private": true,
  "description": "Ball Manager — application iOS (Capacitor 8). Partage le code de ../src. Voir docs/IOS_AUDIT.md.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "../node_modules/.bin/vitest run --config vitest.config.ts",
    "ios:sync": "npm run build && cap sync ios",
    "ios:open": "cap open ios",
    "ios:live": "CAP_SERVER_URL=http://localhost:5173 cap sync ios",
    "ios:sync:debug": "BM_APNS_ENV=development npm run ios:sync"
  },
  "dependencies": {
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.5.3",
    "@capacitor/ios": "8.5.3",
    "@capacitor/push-notifications": "8.1.3",
    "@fontsource-variable/geist": "5.3.0",
    "@fontsource-variable/geist-mono": "5.3.0",
    "@fontsource-variable/space-grotesk": "5.3.0",
    "@fontsource/instrument-serif": "5.3.0",
    "react-router": "7.18.4"
  },
  "devDependencies": {
    "@capacitor/cli": "8.5.3",
    "@tailwindcss/vite": "4.3.3",
    "@vitejs/plugin-react": "5.2.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  }
}

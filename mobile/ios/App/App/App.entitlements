<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Notifications APNs. Xcode passe à « production » à l'export App Store / TestFlight. -->
	<key>aps-environment</key>
	<string>development</string>
	<!-- Universal Links : AASA servi par www.ball-manager.fr (Team YFZ72KY47V). -->
	<key>com.apple.developer.associated-domains</key>
	<array>
		<string>applinks:www.ball-manager.fr</string>
		<string>applinks:ball-manager.fr</string>
	</array>
</dict>
</plist>

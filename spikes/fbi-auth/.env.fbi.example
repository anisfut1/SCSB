# Copier en .env.fbi.local (jamais commité) si tu veux préparer un login
# automatique "best effort" (voir README.md — non garanti, retombe sur la
# connexion manuelle en cas d'échec). Laisser vide pour n'utiliser QUE le
# mode manuel (recommandé et suffisant pour ce spike).
FBI_USERNAME=
FBI_PASSWORD=

# Optionnel — base FBI à utiliser si elle diffère de la valeur par défaut
# du script (https://extranet.ffbb.com/fbi).
FBI_BASE_URL=

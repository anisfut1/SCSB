# Copier vers .env pour le développement local (`npm run dev`) — ne JAMAIS
# commiter le fichier .env réel. En production (Railway/Render/Fly), ces
# variables se configurent dans le tableau de bord de la plateforme, jamais
# dans un fichier commité (§51 du brief FBI).

# Même projet Supabase que l'app Next.js (voir ../.env.example côté app).
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# EXACTEMENT la même valeur que FBI_CREDENTIALS_ENCRYPTION_KEY côté app
# (../.env.example) — sinon le worker ne peut déchiffrer aucun identifiant
# FBI. 32 octets encodés en base64, ex : `openssl rand -base64 32`.
FBI_CREDENTIALS_ENCRYPTION_KEY=

# Optionnels (valeurs par défaut raisonnables, voir src/config.ts) :
# WORKER_ID=worker-1
# WORKER_POLL_INTERVAL_MS=15000
# WORKER_CONCURRENCY=2
# PORT=8080
# FBI_BASE_URL=https://extranet.ffbb.com/fbi

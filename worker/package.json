{
  "name": "scsb-fbi-worker",
  "version": "0.1.0",
  "private": true,
  "description": "Worker séparé (hors Vercel) qui consomme la file fbi_jobs et pilote Playwright pour l'automatisation FBI/e-Marque. Voir README.md.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.116.0",
    "playwright": "^1.63.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.1"
  }
}
